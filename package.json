{
  "name": "poplist",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"hono,next\" -c \"green,blue\" \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "build": "turbo build",
    "kubb:generate": "npm run generate:spec --workspace=backend && kubb generate && (trash frontend/node_modules/.vite 2>/dev/null || true)",
    "open-api": "npm run generate:spec --workspace=backend && node scripts/build-api-docs.mjs && open private/api-docs.html",
    "mobile:dev": "npm --prefix mobile run dev",
    "mobile:dev:clear": "npm --prefix mobile run dev:clear",
    "mobile:build:dev": "npm --prefix mobile run build:android:dev",
    "mobile:build:preview": "npm --prefix mobile run build:android:preview",
    "mobile:install:dev": "npm --prefix mobile run install:dev",
    "mobile:install:preview": "npm --prefix mobile run install:preview",
    "mobile:update:preview": "npm --prefix mobile run update:preview --",
    "mobile:channel:list": "npm --prefix mobile run channel:list",
    "mobile:channel:link": "npm --prefix mobile run channel:link --",
    "mobile:typecheck": "cd mobile && node --stack-size=8000 node_modules/typescript/lib/tsc.js --noEmit",
    "mobile:update:main": "npm --prefix mobile run update:main",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm --workspace=backend run typecheck && npm --workspace=frontend run typecheck",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "npm --workspace=backend run test",
    "test:e2e": "npm --workspace=frontend run test:e2e",
    "test:e2e:headed": "npm --workspace=frontend run test:e2e:headed",
    "test:e2e:ui": "npm --workspace=frontend run test:e2e:ui",
    "db-push-test": "npm --workspace=backend run db-push-test"
  },
  "devDependencies": {
    "@kubb/core": "^4.39.2",
    "@kubb/plugin-client": "^4.39.2",
    "@kubb/plugin-oas": "^4.39.2",
    "@kubb/plugin-react-query": "^4.39.2",
    "@kubb/plugin-ts": "^4.39.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "kubb": "^3.2.2",
    "turbo": "^2",
    "wait-on": "^9.0.10"
  }
}
